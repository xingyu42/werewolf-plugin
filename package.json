{
    "name": "werewolf-plugin",
    "version": "0.8.0",
    "description": "狼人杀游戏插件 - 支持多人在线狼人杀游戏",
    "type": "module",
    "main": "index.js",
    "scripts": {
        "test": "set NODE_OPTIONS=--experimental-vm-modules && jest",
        "test:watch": "set NODE_OPTIONS=--experimental-vm-modules && jest --watch",
        "test:coverage": "set NODE_OPTIONS=--experimental-vm-modules && jest --coverage",
        "test:unix": "NODE_OPTIONS='--experimental-vm-modules' jest",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "start": "node index.js"
    },
    "keywords": [
        "werewolf",
        "game",
        "yunzai",
        "plugin",
        "multiplayer"
    ],
    "author": "Werewolf Plugin Team",
    "license": "MIT",
    "engines": {
        "node": ">=18.0.0"
    },
    "devDependencies": {
        "@eslint/js": "^9.0.0",
        "eslint": "^9.0.0",
        "jest": "^29.0.0"
    },
    "dependencies": {}
}