{
    "name": "werewolf-plugin",
    "version": "0.8.0",
    "description": "狼人杀游戏插件 - 支持多人在线狼人杀游戏",
    "type": "module",
    "main": "index.js",
    "scripts": {
        "test": "cross-env NODE_OPTIONS=--experimental-vm-modules jest",
        "test:watch": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --watch",
        "test:coverage": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --coverage",
        "test:ci": "cross-env NODE_OPTIONS=--experimental-vm-modules CI=true jest --config=jest.config.ci.js",
        "test:ci:coverage": "cross-env NODE_OPTIONS=--experimental-vm-modules CI=true jest --config=jest.config.ci.js --coverage",
        "test:unit": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --testPathPattern=unit/",
        "test:integration": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --testPathPattern=integration/",
        "test:system": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --testPathPattern=system/",
        "test:unix": "NODE_OPTIONS='--experimental-vm-modules' jest",
        "test:verbose": "cross-env NODE_OPTIONS=--experimental-vm-modules JEST_VERBOSE=true jest",
        "quality-report": "node scripts/test-quality-report.js",
        "quality-check": "npm run test:coverage && npm run quality-report",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "start": "node index.js"
    },
    "keywords": [
        "werewolf",
        "game",
        "yunzai",
        "plugin",
        "multiplayer"
    ],
    "author": "Werewolf Plugin Team",
    "license": "MIT",
    "engines": {
        "node": ">=18.0.0"
    },
    "devDependencies": {
        "@eslint/js": "^9.0.0",
        "cross-env": "^7.0.3",
        "eslint": "^9.0.0",
        "jest": "^29.0.0"
    }
}
